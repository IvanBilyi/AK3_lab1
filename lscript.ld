/* Опис фізичних областей пам'яті */
MEMORY
{
    /* FLASH - постійна пам'ять: для зберігання програмного коду */
    FLASH (rx) : ORIGIN = 0x08000000, LENGTH = 1M

    /* RAM - оперативна пам'ять: для змінних та роботи стеку */
    RAM (rwx)  : ORIGIN = 0x20000000, LENGTH = 128K
}

/* * Визначення адреси вершини стеку (_stack_start).
 * Оскільки стек у архітектурі ARM росте вниз, встановлює його 
 * на останню адресу оперативної пам'яті.
 */
_stack_start = ORIGIN(RAM) + LENGTH(RAM);
